    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@wakeupbabe/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250405.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
