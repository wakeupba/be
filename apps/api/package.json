{
  "name": "@wakeupbabe/api",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply wakeupbabe --local",
    "db:migrate:remote": "wrangler d1 migrations apply wakeupbabe --remote",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "sim:dodo": "node scripts/simulate-dodo.mjs",
    "dev:bare": "wrangler dev --test-scheduled",
    "email": "email dev --dir src/services/email --port 3005"
  },
  "dependencies": {
    "@sentry/cloudflare": "^10.69.0",
    "@wakeupbabe/shared": "workspace:*",
    "dodopayments": "^2.42.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0",
    "libphonenumber-js": "^1.13.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.1",
    "resend": "^6.18.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@cloudflare/workers-types": "^4.20250405.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.0.0"
  }
}
