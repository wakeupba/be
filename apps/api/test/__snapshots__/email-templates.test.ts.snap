exports[`email templates > calendar broken renders stable copy 1`] = `
{
  "subject": "Google Calendar access needs reconnecting",
  "text": "Google revoked our read access to your calendar.

Meetings we already flagged will still ring at their last known times, but new events, changes, and cancellations are invisible to us until you reconnect.

Reconnect: https://app.wakeupba.be/call-setup/

Wake Up Babe · you received this because a scheduled call could not reach you.",
}
`;

